#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Utamakan Node v22+ (~/.local/bin / ~/.hermes/node/bin) dan Bun lokal di depan NVM Node v20
for candidate in \
  "$HOME/.config/OpenBot/provider-runtimes/bun/linux-x64/1.4.4/bin" \
  "$HOME/.bun/bin" \
  "$HOME/.hermes/node/bin" \
  "$HOME/.local/bin"; do
  if [ -d "$candidate" ]; then
    export PATH="$candidate:$PATH"
  fi
done

if ! command -v bun >/dev/null 2>&1; then
  echo "Error: 'bun' tidak ditemukan. Instal Bun dengan: curl -fsSL https://bun.sh/install | bash" >&2
  exit 1
fi

# Siapkan virtual display (Xvfb) jika berjalan di server Linux tanpa layar (headless)
if [ "$(uname -s)" = "Linux" ] && [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
  if command -v Xvfb >/dev/null 2>&1; then
    rm -f /tmp/.X0-lock /tmp/.X11-unix/X0 /tmp/.X1-lock /tmp/.X11-unix/X1
    (Xvfb :0 -screen 0 1280x800x24 -nolisten tcp >/dev/null 2>&1 &)
    (Xvfb :1 -screen 0 1280x800x24 -nolisten tcp >/dev/null 2>&1 &)
    export DISPLAY=:0
    export OPENBOT_AGENT_DISPLAY=:1
    sleep 0.5
  fi
fi

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-launch >/dev/null 2>&1; then
  eval "$(dbus-launch --sh-syntax 2>/dev/null || true)"
fi

USER_ID="$(id -u)"
if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
  if [ -d "/run/user/$USER_ID" ]; then
    export XDG_RUNTIME_DIR="/run/user/$USER_ID"
  else
    export XDG_RUNTIME_DIR="/run/openbot"
    mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || true
    chmod 0700 "$XDG_RUNTIME_DIR" 2>/dev/null || true
  fi
fi

export OPENBOT_SERVER=1
export OPENBOT_SHARED_DEV_PROFILE=1

case "${1:-}" in
  stop|status|forget)
    cmd="$1"
    shift
    exec bun "$SCRIPT_DIR/scripts/dev-stack.ts" "$cmd" "$@"
    ;;
  app|web|api|sync)
    mode="$1"
    shift
    exec bun "$SCRIPT_DIR/scripts/selfhost.ts" "$mode" "$@"
    ;;
  *)
    exec bun "$SCRIPT_DIR/scripts/selfhost.ts" "$@"
    ;;
esac
